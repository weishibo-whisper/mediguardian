# ============================================================
# 守药人 MediGuardian — 环境变量模板
# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略
# ============================================================

# ---------- LLM 接入（OpenAI 兼容协议）----------
# provider: mock | openai | deepseek | zhipu | qwen | anthropic
# 默认 mock：不联网、不需要密钥，走内置规则引擎，可完整演示全部链路
LLM_PROVIDER=mock

# 示例 A：DeepSeek（性价比高，比赛推荐）
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 示例 B：智谱 GLM（支持视觉，用于药盒拍照识别）
# LLM_PROVIDER=zhipu
# LLM_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus
# VISION_MODEL=glm-4v-plus

# 示例 C：OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini

# 通用覆盖项（优先级高于上面各 provider 预设）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
VISION_MODEL=

# 生成温度：0 ~ 1，用药场景建议 ≤ 0.3 保证稳定可控
LLM_TEMPERATURE=0.2

# ---------- 检索增强 ----------
# 混合检索：BM25 + 本地哈希向量 + RRF 融合 + 规则重排
RAG_TOP_K=6
RAG_MIN_SCORE=0.12

# ---------- 安全与审计 ----------
# 审计日志（JSONL），相对项目根目录
AUDIT_LOG_PATH=logs/audit.jsonl
# 输出守卫强度：strict | balanced
SAFETY_MODE=strict
# 单次会话最大 Agent 步数
AGENT_MAX_STEPS=6

# ---------- MCP ----------
# MCP Server 传输方式：stdio（默认，供本地 Agent 客户端）| http
MCP_TRANSPORT=stdio
